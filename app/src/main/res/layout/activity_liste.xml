<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F9"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titreListe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Logements disponibles"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Exercice 4 : ouvre l'écran de connexion -->
        <Button
            android:id="@+id/boutonConnexion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connexion" />
    </LinearLayout>

    <!-- Exercice 3 : barre de recherche par ville -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/champVille"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ville (vide = toutes)"
            android:inputType="textCapWords"
            android:imeOptions="actionSearch" />

        <Button
            android:id="@+id/boutonChercher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Chercher" />
    </LinearLayout>

    <!-- Exercice 2 : message affiché seulement en cas d'erreur -->
    <TextView
        android:id="@+id/messageErreur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#B3261E"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp">

        <!-- Conteneur vide : les cartes sont ajoutées en Java -->
        <LinearLayout
            android:id="@+id/conteneurLogements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
